# ── Environment ──────────────────────────────────────────────────────────────
# Set to 'production' in deployed environments.
# Non-development environments enforce stronger secret validation at startup.
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=civic_fact_audit
POSTGRES_USER=postgres
# REQUIRED in non-development: must not be the default 'postgres'
POSTGRES_PASSWORD=postgres

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in non-development: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
AUTH_SECRET_KEY=change-me-in-prod

# Token lifetime in minutes (1–1440). Default 480 (8 h). Tighten for production.
AUTH_TOKEN_TTL_MINUTES=480

# ── Bootstrap Reviewer Account ────────────────────────────────────────────────
# Created once on first startup. Change password immediately after first login.
REVIEWER_BOOTSTRAP_EMAIL=reviewer@local
# REQUIRED in non-development: must not be the default 'change-me'
REVIEWER_BOOTSTRAP_PASSWORD=change-me
REVIEWER_BOOTSTRAP_NAME=Local Reviewer

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON list of allowed origins for browser cross-origin requests.
# REQUIRED in non-development: must not be the default localhost list.
# Example: CORS_ALLOWED_ORIGINS='["https://admin.example.com","https://app.example.com"]'
CORS_ALLOWED_ORIGINS='["http://localhost:5500","http://127.0.0.1:5500"]'

# ── OpenAI (scripts only) ─────────────────────────────────────────────────────
# Used by extraction/AI scripts, not by the main API server.
OPENAI_API_KEY=
