APP_NAME=civic-fact-audit
APP_ENV=development
APP_VERSION=0.1.0
API_PORT=8000

POSTGRES_HOST=localhost
# Compose exposes PostgreSQL on 5433 to the host. Use 5432 only when PostgreSQL runs directly on the host.
POSTGRES_PORT=5433
POSTGRES_DB=civic_fact_audit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

OPENAI_API_KEY=replace_me
OPENAI_REVIEW_DRAFT_MODEL=gpt-5-mini
OPENAI_REVIEW_DRAFT_MAX_COMPLETION_TOKENS=1600
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_ESCALATION_MODEL=claude-sonnet-4-6
ANTHROPIC_ESCALATION_MAX_TOKENS=2500
GEMINI_API_KEY=replace_me
# Set to true after a failed regression health check to skip primary model and disable green-lane publishing
CIVIC_AI_DEGRADED_MODE=false
AUTH_SECRET_KEY=change-me-in-prod
AUTH_TOKEN_TTL_MINUTES=480
REVIEWER_BOOTSTRAP_EMAIL=reviewer@local
REVIEWER_BOOTSTRAP_PASSWORD=change-me
REVIEWER_BOOTSTRAP_NAME=Local Reviewer
